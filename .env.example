# ---------------------------------------------------------------------------
# Telegram Order Management & Routing Bot - environment configuration
# Copy this file to .env and fill in the values.
#
# NOTE: only credentials and the bootstrap admin list live here. Every
# functional setting (sources, work groups, routes, operators, rules,
# destinations, reactions) is configured from inside the Telegram admin panel.
# ---------------------------------------------------------------------------

# Token issued by @BotFather. REQUIRED.
BOT_TOKEN=

# Comma separated Telegram user IDs that bootstrap as Super Admins. REQUIRED.
SUPERADMIN_IDS=123456789,987654321

# --- PostgreSQL (used by docker-compose to provision the database) ---
POSTGRES_DB=telegram_orders
POSTGRES_USER=telegram_orders
POSTGRES_PASSWORD=change-me-please
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full async SQLAlchemy DSN. When left empty it is assembled from the
# POSTGRES_* variables above.
DATABASE_URL=postgresql+asyncpg://telegram_orders:change-me-please@postgres:5432/telegram_orders

# --- Application ---
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=Asia/Tehran

# Internal health check endpoint (no public domain / SSL required).
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Run `alembic upgrade head` automatically on container start.
RUN_MIGRATIONS_ON_START=true

# Telegram delivery tuning
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY=1.0

# Minimum seconds between two identical admin notifications (spam protection)
ADMIN_NOTIFICATION_COOLDOWN=300
